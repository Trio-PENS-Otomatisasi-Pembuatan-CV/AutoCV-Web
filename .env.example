# Base URL for frontend API client
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Mode selector: 'mock' (simulated offline runner) or 'live' (UiPath Orchestrator)
NEXT_PUBLIC_UIPATH_MODE=mock

# UiPath Orchestrator Connection (Required when NEXT_PUBLIC_UIPATH_MODE=live)
UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com/{orgName}/{tenantName}/orchestrator_
UIPATH_CLIENT_ID=your-client-id-here
UIPATH_CLIENT_SECRET=your-client-secret-here
UIPATH_TENANT_NAME=DefaultTenant
UIPATH_FOLDER_ID=12345
UIPATH_PROCESS_KEY_JOB1=AutoCV_Job1_ScrapeAndSynthesize
UIPATH_PROCESS_KEY_JOB2=AutoCV_Job2_RenderPDF

# Backend Webhook Base URL (used by UiPath Robot to call back)
BACKEND_WEBHOOK_BASE_URL=http://localhost:3000
